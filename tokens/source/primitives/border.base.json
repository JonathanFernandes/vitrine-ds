          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 32
      },
      "2xs": {
        "$description": "Arredondamento mínimo. Valor varia por tema (1–2px).",
        "$scopes": [
          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 1
      },
      "3xl": {
        "$description": "48px. Uso: elementos circulares grandes.",
        "$scopes": [
          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 48
      },
      "lg": {
        "$description": "16px. Uso: bottom sheets, drawers.",
        "$scopes": [
          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 16
      },
      "md": {
        "$description": "12px. Uso: cards, containers — valor padrão mais usado.",
        "$scopes": [
          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 12
      },
      "round": {
        "$description": "999px. Uso: chips, avatars, botões pill.",
        "$scopes": [
          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 999
      },
      "sharp": {
        "$description": "Sem arredondamento. Uso: elementos angulares (raros no DS).",
