          "STROKE_FLOAT"
        ],
        "$type": "float",
        "$value": 2
      },
      "stroke-none": {
        "$description": "0px. Sem borda.",
        "$scopes": [
          "STROKE_FLOAT"
        ],
        "$type": "float",
        "$value": 0
      },
      "stroke-thick": {
        "$description": "4px. Destaques especiais.",
        "$scopes": [
          "STROKE_FLOAT"
        ],
        "$type": "float",
        "$value": 4
      },
      "stroke-thin": {
        "$description": "1px. Bordas de inputs e cards — valor padrão.",
        "$scopes": [
          "STROKE_FLOAT"
        ],
        "$type": "float",
        "$value": 1
      }
    }
