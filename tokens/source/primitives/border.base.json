          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 0
      },
      "sm": {
        "$description": "8px. Uso: inputs, botões pequenos.",
        "$scopes": [
          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 8
      },
      "xl": {
        "$description": "24px. Uso: overlays grandes.",
        "$scopes": [
          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 24
      },
      "xs": {
        "$description": "Arredondamento pequeno. Valor varia por tema (2–4px).",
        "$scopes": [
          "CORNER_RADIUS"
        ],
        "$type": "float",
        "$value": 4
      }
    },
    "stroke": {
      "stroke-hairline": {
        "$description": "0.5px. Divisores sutis.",
        "$scopes": [
          "STROKE_FLOAT"
        ],
        "$type": "float",
        "$value": 0.5
      },
      "stroke-medium": {
        "$description": "2px. Estado de foco, ênfase.",
